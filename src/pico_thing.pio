.pio_version	1

% c-sdk {

#include "mc6809.h"
// GPIO_TASK_BASE moves with the board revision, and pioasm has no
// conditionals, so it comes from the pin map rather than a .define here.
// The task program sets its pin base at runtime, so nothing in the
// instruction stream depends on it.
#include "pico_thing.h"

%}

.define	public	GPIO_E		0
.define	public	GPIO_Q		1

.define	public	GPIO_RW		2	; R/!W
; BOTH BUSES ARE LSB-AT-BASE: GPIO 3 is A0 and GPIO 8 is A5; GPIO 9 is D0 and
; GPIO 16 is D7.  Spelled out because it is not inferable from a base address,
; and because the old annotation "A5-0" read as though GPIO 3 were A5 - which
; is how an address filter came to test A0 and A1 believing they were A5 and A4.
; What settles it: union bus_pins' "A : 6" and "D : 8" start at those bits and
; are used as a register offset and a data byte DIRECTLY - see the DAT-fault
; test in the Q handler, and the trace's D column, where a guest "20 FE" at
; $0000 reads back as A=00 D=20, A=01 D=FE.
.define	public	GPIO_A_BASE	3	; A0 at GPIO 3 ... A5 at GPIO 8
.define	public	GPIO_D_BASE	9	; D0 at GPIO 9 ... D7 at GPIO 16
.define	public	GPIO_CS		17	; !CS_PICO
.define	public	GPIO_TRACE_RD	27	; Debugging
.define	public	GPIO_TRACE_WR	28	; Debugging

; 4-cycle quadrature clock loop. Q leads E by 90 deg.
; Side-set bits [Q:E] as Q is 0b10, E is 0b01.
;
; Two of the four instructions carry an "irq next set" as well as their
; side-set, which costs nothing: all four were nop placeholders for the
; side-set, and the loop is still four PIO clocks, so E's frequency and duty are
; untouched.  Both ticks go to pio2, one per E cycle each.
;
; Flag 0, on the LAST instruction, is Q-falling: it ticks the bus_fault sampler,
; for the phase reasons set out below.
;
; Flag 1, on the FIRST instruction, is E-falling.  NOTHING CONSUMES IT.  It fed
; the BUSY/LIC/AVMA mirror's sampler, which is gone: the Q-rising handler reads
; those three straight off the pins, and measurably lands past t_CD, so it gets
; the raw in-advance values - "the NEXT cycle is an opcode fetch".  That is the
; phase anything acting a cycle ahead wants; the mirror re-phased them to "this
; cycle", useful for a display and a cycle too late to act on.
;
; The instruction stays, and it stays SETTING the flag.  This loop's four slots
; ARE the E/Q timing, so the slot cannot go; turning it into a plain nop would
; save nothing at run time and would throw away the only E-falling tick PIO
; has - the phase that is safely past t_CD at every supported E, which is
; exactly what a sampler of the in-advance signals wants.  Re-adding it later
; would mean editing this program, which is the one change that obliges a
; re-run of the whole BUSY/LIC/AVMA bench recipe.  Nothing on pio2 enables
; flag 1 as an interrupt source either (only pis_interrupt3, the DAT fault), so
; a standing flag interrupts nothing.
;
; TWO THINGS FOR WHOEVER USES IT NEXT.  Only one waiter: a satisfied wait clears
; the flag, so two state machines cannot share it.  And because the flag has
; been standing set with nothing consuming it, **the first wait is satisfied
; immediately** rather than at the next E-falling - clear it when enabling the
; state machine, or discard that first sample.
;
; THE PHASE IS THE POINT.  That instruction is the one that drops Q while E is
; still high, and Q-falling is where the DAT fault signal must be sampled: the
; Fault line is a registered output of the DAT GAL clocked on Q-RISING, so
; sampling at Q-rising would read it at the instant it changes, while the 6809
; guarantees A0-A15, R/!W, BA and BS are stable from before Q rises until about
; 20 ns after E falls.  Q-falling therefore sits in the middle of a window
; where the registered signal and the live bus pins are both settled and both
; describe the same cycle.
;
; THIS PROGRAM LIVES ON pio1, AND THE DIRECTION OF THOSE TICKS DEPENDS ON IT.
; The three blocks wrap, so "next" from pio1 is pio2 - which is where the
; bus_fault sampler waiting on flag 0 lives.  It was on pio0 until 2026-10-07,
; where the same tick was reached with "irq PREV set" (prev from pio0 is also
; pio2).  It moved to free 4 of pio0's 32 words for the address filter that the
; per-cycle redesign needs: pio0 is the only base-0 block with room for the
; read program, and clock + read + capture_lo had it at 30 of 32.
;
; So if this program is moved again, the ticks land in a different block WITHOUT
; A WORD OF WARNING - nothing fails to assemble, the sampler simply never runs.
; The flag NUMBERS are unaffected: a flag is set in the TARGET block, so pio2's
; flags 0 and 1 are the same two either way, and bus_fault's "wait 1 irq 0"
; needed no change.
.program	mc6809_clock
.side_set	2
.wrap_target
	irq	next set 1	side 0b00	; Q=0, E=0 - E FALLS here: flag 1, now unused
	irq	next set 5	side 0b10	; Q=1, E=0 - Q RISES: tick the interrupt pins
	nop			side 0b11	; Q=1, E=1
	irq	next set 0	side 0b01	; Q=0, E=1 - Q falls: tick bus_fault
.wrap

% c-sdk {

static inline void
mc6809_clock_program_init(PIO pio, uint sm, uint offset)
{
	pio_gpio_init(pio, GPIO_E);
	pio_gpio_init(pio, GPIO_Q);
	pio_sm_set_consecutive_pindirs(pio, sm, GPIO_E, 2, true);
	pio_sm_config c = mc6809_clock_program_get_default_config(offset);
	sm_config_set_sideset_pins(&c, GPIO_E);	// base E, next Q
	pio_sm_init(pio, sm, offset, &c);
	// pio_sm_set_enabled(pio, sm, false);
}

static inline void
mc6809_clock_program_deinit(PIO pio, uint sm)
{
	pio_sm_set_enabled(pio, sm, false);
	// Drive E and Q low, then release to hi-Z
	gpio_put(GPIO_E, false);
	gpio_put(GPIO_Q, false);
	gpio_set_dir(GPIO_E, GPIO_IN);
	gpio_set_dir(GPIO_Q, GPIO_IN);
	// Return pins to GPIO control (away from PIO)
	gpio_set_function(GPIO_E, GPIO_FUNC_SIO);
	gpio_set_function(GPIO_Q, GPIO_FUNC_SIO);
	pio_sm_unclaim(pio, sm);
}

%}

; Bus READ cycle. The read_registers[] prefix + A0-A5 are sent to the
; DMA read chain as soon as Q goes high. The byte at the given address is
; returned immediately to here, where we can take our time by sending
; to D0-D7 after Q trailing edge. The output is cleared at E trailing edge
; (plus a bit).
;
; To consider: Don't auto-return the read byte ASAP, instead give the
; Pico a chance to decide what to send.
;
; THE ADDRESS FILTER, AND WHY IT IS HERE RATHER THAN IN THE ISR.  Only
; $FFC0-$FFCF needs the CPU told about a read: those are the device registers,
; and they are the only addresses either the read ISR or Core 1's follow-up
; switch branches on.  $FFD0 upwards - shared buffer, snippet area, vectors - is
; plain memory that the DMA serves by itself, and it carries the HOTTEST traffic
; there is: every vector fetch, and every instruction fetch of a snippet running
; at $FFE0.  A guest held in reset reads $FFFE/$FFFF on every single cycle.
;
; So the DMA completion interrupt is off, and this program raises IRQ 4 instead,
; only for the addresses that need it.  The predicate is (A5|A4)==0, so X is
; zero exactly when both are clear and "jmp x--" skips the notify when either
; is set.
;
; MIND THE PIN ORDER.  GPIO_A_BASE (3) carries **A0**, so after the R/!W bit the
; OSR holds A0 first and A5/A4 are the LAST two of the six - hence the
; "out null 4" to discard A0-A3 before taking them.  The annotations used to read
; "A5-0", which specified no order at all and invited exactly the wrong
; inference from a base of 3; they now name both end points.
;
; Getting this wrong fails QUIETLY AND PLAUSIBLY, which is worth a warning: an
; "out x 2" straight after the R/!W reads A0 and A1 instead, so the notify
; fires on every fourth address rather than on the bottom sixteen.  Reads of
; $FFFE/$FFFF then raise nothing, interrupts appear to drop by 99.5%, and it
; looks exactly like success - until the ACIA's receive fast path stops being
; told about $FFC5 and RDRF never clears.
;
; THE PLACEMENT COSTS NOTHING, which is the point.  "out x 2" sits between the
; push and the pull, where the state machine is stalled waiting for the DMA
; round trip anyway (~11 clk_sys cycles, measured).  The test and the irq sit
; after D0-D7 is driven and before the wait for Q to fall, which is most of a Q
; half-cycle of slack - 26 PIO cycles even at 3 MHz.  Neither is on the path
; that has to finish inside the E cycle.
;
; X is free to use: it is reloaded by "mov x isr" on the next served read, so
; jmp x--'s decrement is discarded.  The verdict has to be captured before the
; pull because the pull replaces the OSR with the data byte - but X survives it,
; which is what lets the notify happen AFTER the DMA has run.  That ordering is
; required: the ISR recovers the address from the DMA's own read_addr register,
; so a notify raised before the transfer completed would hand it a stale one.
;
; IN  pins:    (7) A0-A5, R/!W
; OUT pins:    (8) D0-D7
; JMP pin:     !CS
.program	mc6809_bus_read
.side_set	1			; Debugging
; =========================================================
	pull	block		side 0	; Get read_registers[] address (MSBs only) at startup
	mov	y osr		side 0
.wrap_target
wait_q:
	wait	0 gpio GPIO_Q	side 0  ; Wait for new Q cycle
	wait	1 gpio GPIO_Q	side 0
	jmp	pin wait_q	side 0	; If !CS (jmp_pin) is high, try again next cycle
	in	pins 7		side 1	; R/!W, A0-A5 all stable at Q rising edge
	in	null 25		side 1	; Move A0-A5, R/!W to the right
	mov	osr isr		side 1
	out	x 1		side 1	; Get R/!W
	jmp	!x wait_q	side 1	; If R/!W == 0 -> Write
	mov	x isr		side 1	; Get back A0-A5, R/!W
	in	x 7		side 1
	mov	x y		side 1  ; Get registers[] address
	in	x 26		side 1  ; MSBs of registers[], R/!W falls off the end
	push	block		side 1	; Send full address = registers[] + A0-A5
	out	null 4		side 1	; discard A0-A3; GPIO3 is A0, NOT A5
	out	x 2		side 1	; A4,A5 - grabbed BEFORE the pull overwrites the OSR
public dma_wait:
	pull	block		side 1	; Wait for data byte reply
	out	pins 8		side 0	; Set D0-D7 output values
	jmp	x-- no_notify	side 0	; A5 or A4 set: plain memory, tell the CPU nothing
	irq	set 4		side 0	; $FFC0-$FFCF is a device register: notify
no_notify:
	wait	0 gpio GPIO_Q	side 0	; Q trailing edge
	mov	pindirs !null	side 1	; Set D0-D7 to outz                                                                                                                                                                                                                                                                                                                                                                                                                      cput
	wait	0 gpio GPIO_E	[7] side 1	; E trailing edge plus a bit
	mov	pindirs null	side 0	; Set D0-D7 back to input
.wrap

% c-sdk {

static inline void
mc6809_bus_read_program_init(PIO pio, uint sm, uint offset)
{
	for (uint i = 0; i < 8; i++)
		pio_gpio_init(pio, GPIO_D_BASE + i);
	pio_sm_set_consecutive_pindirs(pio, sm, GPIO_D_BASE, 8, false);
	pio_gpio_init(pio, GPIO_TRACE_RD);
	pio_sm_set_consecutive_pindirs(pio, sm, GPIO_TRACE_RD, 1, true);
	pio_sm_config c = mc6809_bus_read_program_get_default_config(offset);
	sm_config_set_in_pins(&c, GPIO_RW);
	sm_config_set_in_shift(&c, true, false, 32);	// Right shift!!
	sm_config_set_out_pins(&c, GPIO_D_BASE, 8);
	sm_config_set_out_shift(&c, true, false, 32);	// Right shift!!
	sm_config_set_jmp_pin(&c, GPIO_CS);
	sm_config_set_sideset_pins(&c, GPIO_TRACE_RD);
	pio_sm_init(pio, sm, offset, &c);
	// pio_sm_set_enabled(pio, sm, false); // We'll start this when DMA, the IRQ's and the second core get going.
}

static inline void
mc6809_bus_read_program_deinit(PIO pio, uint sm)
{
	pio_sm_set_enabled(pio, sm, false);
	// D0-D7 back to hi-Z input
	pio_sm_set_consecutive_pindirs(pio, sm, GPIO_D_BASE, 8, false);
	for (uint i = 0; i < 8; i++)
		gpio_set_function(GPIO_D_BASE + i, GPIO_FUNC_SIO);
	// Trace pin low then hi-Z
	gpio_put(GPIO_TRACE_RD, false);
	gpio_set_dir(GPIO_TRACE_RD, GPIO_IN);
	gpio_set_function(GPIO_TRACE_RD, GPIO_FUNC_SIO);
	pio_sm_unclaim(pio, sm);
}

%}

; Bus WRITE cycle. The write_registers[] prefix + A0-A5 are sent to the
; DMA chain as soon as Q goes high. As soon as E goes high, we grab D0-D7
; and send this back to the DMA chain for storage at the given address.
;
; IN pins: (7) A0-A5, R/!W
; IN pins: (8) D0-D7
; JMP pin: !CS
.program	mc6809_bus_write
.side_set	1			; Debugging
; =========================================================
	pull	block		side 0	; Get registers[] address (MSBs only) at startup
	mov	y osr		side 0
.wrap_target
wait_q:
	wait	0 gpio GPIO_Q	side 0  ; Wait for new Q cycle
	wait	1 gpio GPIO_Q	side 0
	jmp	pin wait_q	side 0	; If !CS (jmp_pin) is high, try again next cycle
	in	pins 7		side 1	; A0-A5, R/!W all stable at Q rising edge
	in	null 25		side 1	; Move A0-A5, R/!W to the right
	mov	osr isr		side 1
	out	x 1		side 1	; Get R/!W
	jmp	x-- wait_q	side 1	; If R/!W == 1 -> Read
	mov	x isr		side 1	; Get back A0-A5, R/!W
	in	x 7		side 1
	mov	x y		side 1  ; Get registers[] address
	in	x 26		side 1  ; MSBs of registers[], R/!W falls off the end
	push	block		side 1	; Send full address = registers[] + A0-A5
	wait	1 gpio GPIO_E	side 0	; E leading edge
	in	pins 15		side 1	; Get D0-D7, A0-A5, R/!W
	in	null 24		side 1	; Get D0-D7 to the right; A0-A5 + R/!W fall of the end
	push	block		side 1	; Send D0-D7
.wrap

% c-sdk {

static inline void
mc6809_bus_write_program_init(PIO pio, uint sm, uint offset)
{
	pio_gpio_init(pio, GPIO_TRACE_WR);
	pio_sm_set_consecutive_pindirs(pio, sm, GPIO_TRACE_WR, 1, true);
	pio_sm_config c = mc6809_bus_write_program_get_default_config(offset);
	sm_config_set_in_pins(&c, GPIO_RW);
	sm_config_set_in_shift(&c, true, false, 32);	// Right shift!!
	sm_config_set_out_shift(&c, true, false, 32);	// Right shift!!
	sm_config_set_jmp_pin(&c, GPIO_CS);
	sm_config_set_sideset_pins(&c, GPIO_TRACE_WR);
	pio_sm_init(pio, sm, offset, &c);
	// pio_sm_set_enabled(pio, sm, false); // We'll start this when DMA, the IRQ's and the second core get going.
}

static inline void
mc6809_bus_write_program_deinit(PIO pio, uint sm)
{
	pio_sm_set_enabled(pio, sm, false);
	// Trace pin low then hi-Z
	gpio_put(GPIO_TRACE_WR, false);
	gpio_set_dir(GPIO_TRACE_WR, GPIO_IN);
	gpio_set_function(GPIO_TRACE_WR, GPIO_FUNC_SIO);
	pio_sm_unclaim(pio, sm);
}

%}


; Atomic TASK pin driver. Pulls a 6-bit word from TX FIFO and outputs it to
; the six consecutive pins at GPIO_TASK_BASE (TASK[4:0] + TASK0), which is
; 40-45 on a version 1 board and 32-37 on version 2.
; Runs at full system clock (320 MHz, no divider).
; Bit layout: [5]=TASK0 (active-high when task==0), [4:0]=task number.
.program	task_output

.wrap_target
	pull	block		; Stall until new task value arrives
	out	pins 6		; Output bits[5:0] to the task pins
.wrap

% c-sdk {

static inline void
task_output_program_init(PIO pio, uint sm, uint offset)
{
	for (uint i = 0; i < 6; i++)
		pio_gpio_init(pio, GPIO_TASK_BASE + i);
	pio_sm_set_consecutive_pindirs(pio, sm, GPIO_TASK_BASE, 6, true);
	pio_sm_config c = task_output_program_get_default_config(offset);
	sm_config_set_out_pins(&c, GPIO_TASK_BASE, 6);
	sm_config_set_out_shift(&c, true, false, 32);	// Right shift, no autopull
	pio_sm_init(pio, sm, offset, &c);
	// Pre-load task 0: TASK0=1, TASK[4:0]=0 → bit pattern 0b100000
	pio_sm_put(pio, sm, (1u << 5));
	// pio_sm_set_enabled(pio, sm, false);  // We'll start this when DMA, the IRQ's and the second core get going.
}

static inline void
task_output_program_deinit(PIO pio, uint sm)
{
	pio_sm_set_enabled(pio, sm, false);
	// Task pins low then hi-Z
	for (uint i = 0; i < 6; i++) {
		gpio_put(GPIO_TASK_BASE + i, false);
		gpio_set_dir(GPIO_TASK_BASE + i, GPIO_IN);
		gpio_set_function(GPIO_TASK_BASE + i, GPIO_FUNC_SIO);
	}
	pio_sm_unclaim(pio, sm);
}

%}

; ---------------------------------------------------------------------------
; Bus capture (low half) — one 32-bit sample of GPIO 0-31 per E cycle.
;
; Taken by the PIO a couple of clocks after E falls, i.e. within ~6ns.  That
; is the one point where the whole cycle is coherent: the 6809 holds address,
; R/!W, BA and BS until ~20ns past E-fall, while write data and Pico-served
; read data are only valid approaching it.  No ISR can hit that window —
; interrupt entry alone is 40-50ns — which is why this moved into the PIO.
;
; The first instruction is the trigger: it spins while the JMP_PIN input is
; high, so capture begins when that pin goes low (the interrupt lines, !CS and
; !HALT are all active low).  Arming in software instead just execs a jump
; past it.  .wrap_target sits after the trigger, so it is consumed once and
; capture then free-runs until the DMA transfer count runs out.
;
; Each sample also pokes IRQ 0 in the PREVIOUS PIO block, where the high half
; is waiting.  PREV/NEXT wrap across the three blocks, so from pio0 that is
; pio2 — which is what lets the low half live on pio0, the only base-0 block
; with instruction memory to spare.  It also keeps the two halves in lockstep:
; every high sample is caused by a low one, so the arrays cannot drift apart.
.program bus_capture_lo
trigger:
	jmp	pin trigger		; spin while the trigger pin is high
.wrap_target
	wait	1 gpio GPIO_E		; resynchronise
	wait	0 gpio GPIO_E		; E falling
	in	pins 32			; autopush -> RX FIFO -> DMA
	irq	prev set 2		; wake the high half (wraps pio0 -> pio2)
.wrap

; Bus capture (high half) — GPIO 32-47, 16 bits per E cycle.
;
; This runs on a PIO whose GPIO base is 16, so it can see the task pins, the
; DAT fault signals and A13-A15 — but NOT E, which is GPIO 0 and outside that
; window.  Hence the IRQ handshake rather than a second edge wait.  The extra
; couple of clocks of lag do not matter: everything in the high word is stable
; for the whole cycle, unlike the data bus.
.program bus_capture_hi
.wrap_target
	wait	1 irq 2			; set by the low half; satisfied wait clears it
	in	pins 16			; autopush -> RX FIFO -> DMA
.wrap

% c-sdk {

// Low half.  Runs on a GPIO-base-0 PIO so it can see E and the whole bus.
// trigger_pin is polled by the JMP_PIN input; capture starts when it goes low.
static inline void
bus_capture_lo_program_init(PIO pio, uint sm, uint offset, uint trigger_pin)
{
	pio_sm_config c = bus_capture_lo_program_get_default_config(offset);
	sm_config_set_in_pins(&c, 0);			// sample GPIO 0-31
	sm_config_set_in_shift(&c, false, true, 32);	// shift left, autopush at 32
	sm_config_set_jmp_pin(&c, trigger_pin);
	sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);	// 8 deep, more slack for DMA
	pio_sm_init(pio, sm, offset, &c);
}

// High half.  Runs on the GPIO-base-16 PIO, driven by the low half's IRQ.
static inline void
bus_capture_hi_program_init(PIO pio, uint sm, uint offset)
{
	pio_sm_config c = bus_capture_hi_program_get_default_config(offset);
	sm_config_set_in_pins(&c, 32);			// sample GPIO 32-47
	sm_config_set_in_shift(&c, false, true, 16);	// shift left, autopush at 16
	sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
	pio_sm_init(pio, sm, offset, &c);
}

// Park an armed SM back on its trigger instruction.
static inline void
bus_capture_lo_program_rearm(PIO pio, uint sm, uint offset)
{
	pio_sm_exec(pio, sm, pio_encode_jmp(offset));
}

// Skip the trigger and start capturing immediately (software arming).
static inline void
bus_capture_lo_program_trigger_now(PIO pio, uint sm, uint offset)
{
	pio_sm_exec(pio, sm, pio_encode_jmp(offset + 1u));
}

// Both halves only sample, so there are no pin directions to hand back - the
// state machine stops and the claim goes with it.
static inline void
bus_capture_lo_program_deinit(PIO pio, uint sm)
{
	pio_sm_set_enabled(pio, sm, false);
	pio_sm_unclaim(pio, sm);
}

static inline void
bus_capture_hi_program_deinit(PIO pio, uint sm)
{
	pio_sm_set_enabled(pio, sm, false);
	pio_sm_unclaim(pio, sm);
}

%}

; Interrupt pin driver - !NMI, !FIRQ and !IRQ, applied at Q rising.
;
; These pins are OPEN COLLECTOR, so the direction register IS the drive: output
; enabled pulls low (asserted), input is hi-Z and the external pull-up takes it
; high.  The pin VALUES are driven low once when the program is initialised and
; never touched again, so "out pindirs" alone asserts and deasserts.  That is
; the same trick the CPU handler used with gpio_set_dir_masked().
;
; WHY THIS IS NOT IN A CPU ISR ANY MORE.  It used to run on every Q rising, and
; on almost every one of those it wrote the same three bits it wrote last time -
; the pending set only changes when a device's state does, which is human or
; 50 Hz timescales.  Here the state machine re-applies the value by itself and
; the CPU writes the FIFO only when something actually changes.
;
; "pull noblock" is the whole trick: on an empty TX FIFO it behaves as
; MOV OSR, X, so the value written LAST TIME is reloaded and re-applied.  X is
; refreshed from the OSR each pass, so a new word from the CPU becomes the value
; that persists from then on.
;
; Q RISING IS THE PHASE ON PURPOSE.  The 6809 samples its interrupt inputs
; around Q falling, so applying a change at Q rising puts it as far from the
; sampling instant as the cycle allows.  That was the reason the CPU version was
; tied to the Q-rising interrupt, and it is why this waits on the clock's flag 5
; rather than free-running.
;
; NOT HALT.  GPIO 23 stays with Core 0, which asserts it from the console; only
; the three interrupt lines are driven here.
.program int_pins
.wrap_target
	wait	1 irq 5		; Q rising, from the clock program on pio1
	pull	noblock		; new mask, or X again when the CPU has sent nothing
	mov	x osr		; remember it, so the next pass re-applies it
	out	pindirs 3	; bit0 !NMI, bit1 !FIRQ, bit2 !IRQ
.wrap

% c-sdk {

// The pins are open collector: value low once, then direction is the drive.
static inline void
int_pins_program_init(PIO pio, uint sm, uint offset, uint pin_base)
{
	for (uint i = 0; i < 3; i++) {
		pio_gpio_init(pio, pin_base + i);
		gpio_set_drive_strength(pin_base + i, GPIO_DRIVE_STRENGTH_8MA);
	}
	pio_sm_config c = int_pins_program_get_default_config(offset);
	sm_config_set_out_pins(&c, pin_base, 3);
	sm_config_set_out_shift(&c, true, false, 32);	// shift right, no autopull
	pio_sm_init(pio, sm, offset, &c);
	// Drive the three pin VALUES low while they are still inputs, so that
	// enabling a direction later asserts the line.  Nothing writes them again.
	pio_sm_exec(pio, sm, pio_encode_mov(pio_pins, pio_null));
	// Start deasserted - all three hi-Z - and seed X with it, so the first
	// "pull noblock" on an empty FIFO reloads "nothing asserted" rather than
	// whatever X powered up holding.
	pio_sm_set_consecutive_pindirs(pio, sm, pin_base, 3, false);
	pio_sm_exec(pio, sm, pio_encode_set(pio_x, 0));
}

static inline void
int_pins_program_deinit(PIO pio, uint sm, uint pin_base)
{
	pio_sm_set_enabled(pio, sm, false);
	// Hand the pins back to SIO as inputs, which is deasserted for an open
	// collector line.  mc6809::deinit() releases them properly afterwards.
	for (uint i = 0; i < 3; i++) {
		gpio_set_dir(pin_base + i, GPIO_IN);
		gpio_set_function(pin_base + i, GPIO_FUNC_SIO);
	}
	pio_sm_unclaim(pio, sm);
}

%}

; FAULT pin interrupt, sampled on the Q falling edge, signalled by IRQ.
;
; This runs on a PIO whose GPIO base is 16, so it can see the GPIO 16-47
; pins, but NOT Q, which is GPIO 1 and outside that window.  Hence the
; IRQ handshake rather than a second edge wait.  The extra couple of
; clocks of lag do not matter: everything in the high word is stable
; for the whole cycle.
.program bus_fault
.wrap_target
next_cycle:
	wait	1 irq 0			; set by the low half; satisfied wait clears it
	jmp	pin got_fault		; An unallocated RAM block has been addressed
	jmp	next_cycle		; All is well
got_fault:
	in	pins 16			; grab the address/page bits A13-A15
	irq	set 3			; Signal the Pico
.wrap

% c-sdk {

// FAULT pin interrupt, sampled on the Q falling edge, signalled by IRQ.
static inline void
bus_fault_program_init(PIO pio, uint sm, uint offset, uint trigger_pin)
{
	pio_sm_config c = bus_fault_program_get_default_config(offset);
	sm_config_set_in_pins(&c, 32);			// sample GPIO 32-47
	sm_config_set_in_shift(&c, false, true, 16);	// shift left, autopush at 16
	sm_config_set_jmp_pin(&c, trigger_pin);
	pio_sm_init(pio, sm, offset, &c);
}

static inline void
bus_fault_program_deinit(PIO pio, uint sm)
{
	pio_sm_set_enabled(pio, sm, false);
	pio_sm_unclaim(pio, sm);
}

%}

